{
  "name": "@nthub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "worker": "tsx --env-file=../../.env src/worker.ts",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/server.ts src/worker.ts --bundle --platform=node --format=esm --packages=external --alias:@nthub/contracts=../../packages/contracts/src/index.ts --outdir=dist",
    "test": "vitest run",
    "start": "node --env-file=../../.env dist/server.js",
    "start:worker": "node --env-file=../../.env dist/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@google/genai": "^1.30.0",
    "@nthub/contracts": "workspace:*",
    "bullmq": "^5.63.0",
    "drizzle-orm": "^0.44.0",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.6.0",
    "nodemailer": "^10.5.0",
    "openid-client": "^6.8.9",
    "pdfjs-dist": "^5.4.0",
    "postgres": "^3.4.7",
    "yauzl": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
